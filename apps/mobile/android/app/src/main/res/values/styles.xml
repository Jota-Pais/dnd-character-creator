<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- O fundo do tema do site (surface-base): a janela, a abertura e as barras do sistema. -->
    <color name="forja_background">#0E0A06</color>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/forja_background</item>
    </style>

    <!-- O tema do app aberto (o BridgeActivity o aplica). Escuro como o site: a janela atrás do
         WebView e das barras do sistema nunca pisca branco. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/forja_background</item>
    </style>

    <!-- A abertura: o d20 do ícone sobre o fundo do tema, até o WebView pintar. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/forja_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
