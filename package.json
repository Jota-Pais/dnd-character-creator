{
  "name": "dnd-character-creator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @rpg/web --",
    "build": "tsc -b && npm run build -w @rpg/web",
    "preview": "npm run preview -w @rpg/web --",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "parse-spells": "node scripts/parse-spells.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.5"
  }
}
