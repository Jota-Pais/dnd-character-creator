# Copie para .env e preencha. O .env nunca vai para o repositório.

# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta da API. O Vite do site repassa /api para cá em desenvolvimento (apps/web/vite.config.ts).
PORT=3333

# Postgres na Neon. Em desenvolvimento, as duas URLs do branch `dev`; em produção, as do branch
# `main`, nas variáveis de ambiente do serviço na Render. Saem do painel da Neon.
#   DATABASE_URL           pooled (com -pooler)  -> a aplicação, pelo driver adapter
#   DATABASE_URL_UNPOOLED  direta (sem -pooler)  -> a CLI do Prisma (migrations, studio)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# A origem do site, sem barra no final. Em produção é obrigatória: pedido que grava vindo de outra
# página é recusado. Mais de uma, separadas por vírgula.
#   Produção: https://dnd-character-creator-gamma.vercel.app
# Em desenvolvimento pode ficar vazia: vale a origem que o proxy do Vite repassa (localhost ou o IP
# da rede).
APP_ORIGIN=
